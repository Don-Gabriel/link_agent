<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!--
      Android blocks cleartext HTTP by default since API 28. The dev backend
      runs on http://10.0.2.2:3000, so without this every request fails with an
      opaque connection error that looks like the server being down.

      DEBUG ONLY: this file is not merged into release builds, so a shipped app
      still refuses plaintext. Production talks to the deployment over HTTPS.
    -->
    <application android:usesCleartextTraffic="true" />
</manifest>
