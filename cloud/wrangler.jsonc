{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "byline-api",
	"compatibility_date": "2026-10-27",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Deploy only after the release checklist in README.md is satisfied.
	"main": "src/index.ts",
	"workers_dev": true,
	"preview_urls": false,
	"ai": {"binding":"AI"},
	"vars": {
		"AI_PROVIDER":"workers-ai",
		"AI_MODEL":"@cf/zai-org/glm-4.7-flash",
		"AI_DISABLE_THINKING":"true",
		"AI_MAX_CONCURRENCY":"1",
		"AI_ACTIVE_JOBS":"2",
		"AI_DAILY_ATTEMPT_LIMIT":"40",
		"AI_REQUIRE_REVIEW":"true"
	},
	"workflows": [
		{"name":"byline-content","binding":"CONTENT","class_name":"ContentWorkflow"},
		{"name":"byline-maintenance","binding":"MAINTENANCE","class_name":"MaintenanceWorkflow"}
	],
	"triggers": {"crons":["* * * * *"]},
	"account_id": "b79d736758ce155523d91c41c43f2ccc",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "byline",
			"migrations_dir": "migrations",
			"database_id": "221e7f65-aef1-47be-8150-d6625d3557cf"
		}
	],
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.01
		}
	}
}
