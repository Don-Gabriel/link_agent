    "local:setup": "node scripts/local-setup.mjs",
    "local:dev": "node scripts/local-dev.mjs",
    "migrate": "tsx scripts/migrate.ts",
    "live:setup": "node scripts/live-setup.mjs",
    "live:dev": "node scripts/live-dev.mjs",
    "live:backup": "node scripts/backup-live.mjs"
  },
  "dependencies": {
