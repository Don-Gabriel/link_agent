{
  "name": "linkedin-creator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:check": "node scripts/build-check.mjs",
    "start": "next start",
    "test": "tsx scripts/selftest.ts",
